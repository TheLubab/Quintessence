{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "$adapt/core": ["./lib/adapt/core/index.ts"],
      "$adapt/core/*": ["./lib/adapt/core/*"],
      "$adapt/kinds": ["./lib/adapt/kinds/index.ts"],
      "$adapt/kinds/*": ["./lib/adapt/kinds/*"],
      "$adapt/layouts": ["./lib/adapt/layouts/index.ts"],
      "$adapt/layouts/*": ["./lib/adapt/layouts/*"],
      "$adapt-canvas": ["./lib/adapt-canvas/index.ts"],
      "$adapt-canvas/*": ["./lib/adapt-canvas/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "lib"]
}
